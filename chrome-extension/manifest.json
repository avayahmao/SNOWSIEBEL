{
  "manifest_version": 3,
  "name": "SNOW Ticket Manager",
  "version": "1.2",
  "description": "Manage ServiceNow tickets in Chrome sidebar using your existing SSO session",
  "permissions": ["cookies", "activeTab", "scripting", "sidePanel"],
  "host_permissions": ["*://avaya.service-now.com/*"],
  "action": {
    "default_icon": {
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "48": "icons/icon48.png"
  }
}
