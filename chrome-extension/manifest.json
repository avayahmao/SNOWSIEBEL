{
  "manifest_version": 3,
  "name": "SNOW + Siebel Ticket Manager",
"version": "2.2",
  "description": "Manage ServiceNow tickets and add Siebel Activity notes from a Chrome sidebar using your existing SSO sessions",
  "permissions": ["cookies", "activeTab", "scripting", "sidePanel"],
  "host_permissions": ["*://avaya.service-now.com/*", "*://gct.avaya.com/*"],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
